{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=IdentityHub;Trusted_Connection=true;TrustServerCertificate=true"
  },
  "FrontendOptions": {
    "BaseUrl": "https://localhost:3000",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password"
  },
  "Jwt": {
    "Audience": "Audience",
    "Issuer": "Identity",
    "Key": "YourSuperSecretKeyHere"
  }
}